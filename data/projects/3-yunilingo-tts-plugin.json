                "        └── Private/PiperBridge.cpp",
                "```"
              ]
            },
            {
              "element": "Build Configuration",
              "description": [
                "```csharp",
                "public class YuniLingo : ModuleRules",
                "{",
                "    public YuniLingo(ReadOnlyTargetRules Target) : base(Target)",
                "    {",
                "        // Enable exceptions for Piper integration",
                "        bEnableExceptions = true;",
                "",
                "        // PiperBridge integration",
                "        PublicIncludePaths.Add(Path.Combine(PiperBridgePath, \"Public\"));",
                "        PublicAdditionalLibraries.Add(\"PiperBridge.lib\");",
                "        RuntimeDependencies.Add(\"PiperBridge.dll\");",
                "    }",
                "}",
                "```"
              ]
            },
            {
              "element": "Build Process",
              "description": "1. Build PiperBridge.dll via BuildBridge.bat, 2. Build Unreal Plugin with standard UE process, 3. Automatic runtime dependency copying"
            }
