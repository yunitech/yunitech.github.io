    {
      "title": "Build System",
      "type": "complex",
      "content": {
        "description": [
          "Modular build system with automated dependency management:"
        ],
        "coreElements": {
          "title": "Build Configuration",
          "elements": [
            {
              "element": "Module Structure",
              "description": [
                "```",
                "YuniLingo/",
                "├── YuniLingo.Build.cs          # Module build configuration",
                "├── YuniLingo.uplugin           # Plugin descriptor",
                "├── Source/YuniLingo/",
                "│   ├── Public/                  # Public API headers",
                "│   ├── Private/                 # Implementation files",
